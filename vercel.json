{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/dashboard", "destination": "/admin/index.html" },
    { "source": "/analytics", "destination": "/admin/index.html" },
    { "source": "/:store/:lang/:category", "destination": "/:lang/:category/index.html?store=:store" },
    { "source": "/:store/:lang", "destination": "/:lang/index.html?store=:store" },
    { "source": "/:lang/:category", "destination": "/:lang/:category/index.html" }
  ]
}
